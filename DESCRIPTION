Package: maidr
Type: Package
Title: Multimodal Access and Interactive Data Representation
Version: 0.4.0.9000
Authors@R: c(
    person("JooYoung", "Seo", email = "jseo1005@illinois.edu", role = c("aut", "cph", "cre")),
