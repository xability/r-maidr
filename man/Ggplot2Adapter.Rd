    \describe{
      \item{\code{plot_object}}{The ggplot2 plot object}
      \item{\code{layer}}{The layer being classified, or NULL for the plot's first}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    TRUE when the layer is drawn as a pie, FALSE otherwise
