    \describe{
      \item{\code{layer_info}}{Layer information for the recorded call}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    An \code{axes} list from \code{\link[=build_axes]{build_axes()}}
  }
