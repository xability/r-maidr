      \item{\code{built}}{Built plot data (optional)}
      \item{\code{panel_id}}{Optional facet panel to restrict extraction to}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    List of \code{list(x, y)} points, one per wedge
