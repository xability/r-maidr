\subsection{\code{BaseRQqlineLayerProcessor$reference_line()}}{
  The intercept and slope \code{stats::qqline} computes

Reproduces the four lines of \code{stats::qqline}'s own body against the
recorded arguments, defaults included. Returns NULL when the call did
not carry a sample this can read, or when the anchors come back
degenerate -- two equal quantiles give a slope of \code{Inf} or \code{NaN}, and
a line through them is not a line the chart drew.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{BaseRQqlineLayerProcessor$reference_line(layer_info)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{layer_info}}{Layer information with the recorded call}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    List with intercept and slope, or NULL
  }
}

