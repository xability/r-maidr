\subsection{\code{BaseRQqlineLayerProcessor$selector_grob_type()}}{
  Which grob family this layer's selectors are drawn from

\code{qqline()} ends in \code{abline()}, so the mark it leaves is an abline's:
\verb{qqnorm(x); qqline(x)} and \verb{plot(x, y); abline(0, 1)} export the same
\code{graphics-plot-1-abline-ab-1}. The parent keys this off the recorded
function name, which here is \code{qqline} rather than \code{abline}, so without
the override the selector would look under \code{lines} and find nothing --
announcing the line correctly and highlighting nothing, which is the
shape of defect #145 was about.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{BaseRQqlineLayerProcessor$selector_grob_type(layer_info)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{layer_info}}{Layer information with the recorded call}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The grob family name
  }
}

