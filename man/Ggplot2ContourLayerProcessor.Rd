  gt = NULL,
  plot = NULL,
  panel_ctx = NULL,
  order = integer(0)
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{gt}}{Gtable object}
      \item{\code{plot}}{The ggplot2 object, used to build a gtable when none is given}
      \item{\code{panel_ctx}}{Panel context for patchwork leaves and facets}
      \item{\code{order}}{The piece behind each emitted curve}
    }
    \if{html}{\out{</div>}}
  }
