Two \code{geom_polygon()} calls draw two grobs in layer order, so the
second layer wants the second match.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{Ggplot2PolygonLayerProcessor$polygon_layer_position(plot, target)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{plot}}{The ggplot2 object}
      \item{\code{target}}{Index of the layer of interest}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The 1-based position, or NULL when the layer is not one
  }
}

