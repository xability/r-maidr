      \item{\code{gt}}{Gtable object}
      \item{\code{panel_ctx}}{Panel context for patchwork leaves and facets}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The grob name, or NULL when it cannot be resolved
